{
  "loc_thresholds": {
    "warning": 500,
    "high": 800,
    "critical": 1000,
    "very_critical": 2000
  },
  "function_length_thresholds": {
    "warning": 40,
    "high": 80,
    "critical": 120,
    "low_complexity_downgrade": 4
  },
  "rules": {
    "naming_min_length": 3,
    "require_docstrings": true,
    "single_class_per_file": true,
    "file_class_name_match": true,
    "procedural_separation": true
  },
  "naming_exceptions": [
    "i",
    "j",
    "k",
    "x",
    "y",
    "z",
    "_",
    "id"
  ],
  "duplication_detection": true,
  "generated_code_detection": true,
  "duplication": {
    "min_tokens": 40,
    "similarity_threshold": 0.99,
    "content_threshold": 0.5,
    "ngram_window": 15
  },
  "cppcheck": {
    "enabled": true,
    "checks": ["warning", "style", "performance", "portability"],
    "inconclusive": false,
    "unused_functions": false,
    "severity": "WARNING",
    "suppress": [],
    "extra_args": [],
    "max_files": 2000,
    "timeout_seconds": 300
  },
  "languages": {
    "python": [
      ".py"
    ],
    "cpp": [
      ".hpp",
      ".hxx",
      ".hh",
      ".h",
      ".cpp",
      ".cc",
      ".cxx"
    ],
    "java": [
      ".java"
    ],
    "php": [
      ".php"
    ],
    "javascript": [
      ".js",
      ".jsx",
      ".mjs",
      ".cjs"
    ]
  },
  "exclude_globs": [
    "**/.venv/**",
    "**/venv/**",
    "**/node_modules/**",
    "**/vendor/**",
    "**/dist/**",
    "**/build/**",
    "**/*.min.js",
    "**/__pycache__/**",
    "**/.git/**",
    "**/.code-intelligence/**"
  ],
  "respect_gitignore": true,
  "test_file_patterns": [
    "test_*.py",
    "*_test.py",
    "*Test.java",
    "*Tests.java",
    "*Test.php",
    "*Tests.php",
    "*.test.js",
    "*.spec.js",
    "*.test.jsx",
    "*.spec.jsx",
    "*.test.mjs",
    "*.spec.mjs",
    "*.test.cjs",
    "*.spec.cjs",
    "test_*.cpp",
    "*_test.cpp",
    "*_gtest.cpp",
    "*Test.cpp",
    "*Tests.cpp",
    "test_*.cc",
    "*_test.cc",
    "*_gtest.cc",
    "test_*.cxx",
    "*_test.cxx",
    "*_gtest.cxx"
  ],
  "config_file_patterns": [
    "*.config.js",
    "*Config.java",
    "*.conf.php",
    "settings.py",
    "config.py"
  ],
  "generated_code_markers": [
    "@generated",
    "DO NOT EDIT",
    "Code generated by",
    "This file is auto-generated",
    "Autogenerated by",
    "<auto-generated"
  ],
  "daemon": {
    "socket_path": null,
    "autostart": false
  },
  "bootstrap": {
    "enabled": true
  },
  "context_budget": {
    "default_max_lines": 200
  },
  "embedded_listing_markers": [
    "\\begin{lstlisting}",
    "\\begin{minted}",
    "\\begin{verbatim}",
    "\\begin{Verbatim}",
    "\\begin{code}"
  ],
  "agent_context": {
    "min_severity": "HIGH",
    "lines_before": 5,
    "lines_after": 5,
    "max_violations": 40,
    "max_context_entries": 40,
    "max_function_index": 25
  },
  "test_dir_names": [
    "tests",
    "test",
    "spec",
    "specs",
    "__tests__",
    "testing"
  ],
  "untested_symbols": {
    "enabled": true,
    "severity": "WARNING",
    "min_loc": 5,
    "include_private": false,
    "kinds": [
      "function",
      "method"
    ]
  }
}
